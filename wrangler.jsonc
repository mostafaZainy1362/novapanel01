{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novapanel01",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2f47be7d-ec15-4ada-b397-54263e43a84d","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4b5c9efe14a04356858a96fa5498596a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
